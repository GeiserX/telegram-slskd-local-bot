# ==============================================================================
# telegram-slskd-local-bot — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For the full reference table, see the configuration page:
#   https://github.com/GeiserX/telegram-slskd-local-bot/blob/main/docs/configuration.md
# ==============================================================================

# ==============================================================================
# TELEGRAM BOT (required)
# ==============================================================================
# Create a bot via @BotFather on Telegram to get the token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs allowed to use the bot
# Get your ID from @userinfobot on Telegram (or message your bot — the
# denial reply includes your ID)
# If empty, the bot denies EVERYONE (fail-closed) — you must set this
TELEGRAM_ALLOWED_USERS=

# Comma-separated Telegram user IDs whose chats default to chat delivery:
# the track is sent into the chat (converted to Opus when over the upload
# cap) and nothing is saved anywhere. /deliver overrides it per chat.
# Empty (default): every chat saves to the library
TELEGRAM_CHAT_DELIVERY_USERS=

# Largest file the bot sends into a chat, in MB of 1,000,000 bytes. Empty means
# 50 (the cloud Bot API's limit, which refuses anything bigger), or 2000 when
# TELEGRAM_API_BASE_URL points at a local Bot API server
TELEGRAM_MAX_UPLOAD_MB=

# ==============================================================================
# LOCAL BOT API SERVER (optional, files up to 2000 MB)
# ==============================================================================
# 1. Log in at https://my.telegram.org, open "API development tools" and create
#    an application; copy its api_id and api_hash here.
# 2. Log the bot out of the cloud server, once:
#    curl https://api.telegram.org/bot<your-bot-token>/logOut
# 3. Set TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081 below.
# 4. Start both: docker compose --profile bigfiles up -d
# The bot reads a file into memory to upload it: on a small machine set
# TELEGRAM_MAX_UPLOAD_MB below the RAM you can spare.
# Empty TELEGRAM_API_BASE_URL (default): Telegram's cloud Bot API, 50 MB cap.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_BASE_URL=

# Read/write timeout in seconds for requests to Telegram, uploads included.
# Empty: 600 with a local server (a 2 GB upload on a LAN), the library's
# defaults otherwise
TELEGRAM_UPLOAD_TIMEOUT_SECS=

# ==============================================================================
# SPOTIFY API (required)
# ==============================================================================
# Create an app at https://developer.spotify.com/dashboard
# Uses Client Credentials flow (no user login needed)
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# ==============================================================================
# SLSKD CONNECTION (required)
# ==============================================================================
# URL of your slskd instance (e.g., http://192.168.1.100:5030)
SLSKD_HOST=http://localhost:5030

# API key from slskd settings (Settings > Security > API Keys)
SLSKD_API_KEY=your_api_key_here

# ==============================================================================
# PATHS
# ==============================================================================
# Where slskd stores completed downloads (inside container)
DOWNLOAD_DIR=/downloads

# Where to place the final renamed files (inside container)
OUTPUT_DIR=/music

# Host paths for the Docker volume mounts in docker-compose.yml. The container
# runs as uid 1000, which must be able to write both folders.
# SLSKD_DOWNLOAD_PATH=/path/to/slskd/downloads
# MUSIC_OUTPUT_PATH=/path/to/music/library

# ==============================================================================
# DOWNLOAD BEHAVIOR
# ==============================================================================

# Default auto-download state for chats that never toggled /auto
# When on, the best match is downloaded and saved without asking
# Set to true once you trust the scoring algorithm
AUTO_MODE=false

# Maximum number of search results to show (default: 10)
MAX_RESULTS=10

# Duration tolerance when matching Spotify duration (seconds)
# Lower = stricter matching, higher = more flexible
DURATION_TOLERANCE_SECS=5

# How long to wait for slskd search results (seconds)
SEARCH_TIMEOUT_SECS=30

# Hours before abandoned files in DOWNLOAD_DIR are auto-deleted (0 disables)
# Abandoned = never approved or rejected (superseded search, restart, timeout)
DOWNLOAD_CLEANUP_HOURS=24

# /wishlist: hours between two searches for the same wished track, and seconds
# to wait between two wish searches (keeps the load on Soulseek peers low)
WISHLIST_CHECK_HOURS=24
WISHLIST_PAUSE_SECS=20

# How long to wait for a download to complete (seconds)
DOWNLOAD_TIMEOUT_SECS=600

# The most a whole album download may take (seconds); an album file gives up
# when its transfer moves no byte for DOWNLOAD_TIMEOUT_SECS
ALBUM_TIMEOUT_SECS=7200

# Keywords in filenames that indicate unwanted versions
# Comma-separated, case-insensitive
EXCLUDE_KEYWORDS=live,remix,acoustic,karaoke,instrumental,cover,demo,radio edit,tribute,remaster

# Output filename template
# Available variables: {artist}, {title}, {track} (two-digit track number of a
# file saved from an album download; dropped with its separator when unknown)
FILENAME_TEMPLATE={artist} - {title}

# ==============================================================================
# LOGGING & HEALTH
# ==============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Health check HTTP port
HEALTH_PORT=8080

# ==============================================================================
# MCP SERVER (optional, see docs/mcp.md)
# ==============================================================================

# Serve the MCP tools over streamable HTTP from the bot process on this port
# (empty = off; `python -m music_downloader mcp` serves stdio either way)
MCP_PORT=

# Address the MCP server binds to. Empty: 127.0.0.1 (local connections only);
# the compose file uses 0.0.0.0, which the container needs for a published port
MCP_HOST=

# Required when MCP_PORT is set: clients send "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
MCP_TOKEN=
